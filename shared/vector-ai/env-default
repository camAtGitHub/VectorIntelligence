# -- Vector AI - LLM backend (OpenRouter) --------------------------------------
# Wire-Pod still talks to THIS service at http://127.0.0.1:8090/v1 (OpenAI-
# compatible). Only the upstream behind vector-ai is configured here.
#
# Personality: edit persona.txt next to this file (not the API key / model).
# Command/vision rules: Wire-Pod knowledge openai_prompt (apply-wirepod-config).

# Required - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI-compatible base URL (no trailing slash required)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Main conversation model (interactive chat only).
# Can be a stronger / non-vision model if LLM_VISION_MODEL is set.
# Browse: https://openrouter.ai/models
LLM_MODEL=google/gemini-2.0-flash

# Multimodal vision (ambient camera glances + chat replies that include a photo).
# Defaults to LLM_MODEL if unset. Prefer a vision-capable OpenRouter slug.
LLM_VISION_MODEL=google/gemini-2.0-flash

# Cheap/fast text model for: mood, conversation summaries, desk extract,
# proactive greetings, and sensor quips (pickup/pet/fall). Not for images.
LLM_SUMMARY_MODEL=google/gemini-2.0-flash-lite

# Max user/assistant turns forwarded to the LLM (Wire-Pod may keep more).
LLM_MAX_HISTORY_MESSAGES=24

# Sampling temperatures (OpenRouter/OpenAI range 0–2; bad values fall back).
# Each call path has its own knob — set only the ones you care about.
# Knowledge chat (Wire-Pod → /v1/chat/completions). Request body temp is ignored.
LLM_TEMPERATURE=1.0
# Conversation summary after a chat (factual, low creativity)
LLM_SUMMARY_TEMPERATURE=0.3
# Background mood reflection
LLM_MOOD_TEMPERATURE=0.7
# Ambient glance novelty line
LLM_AMBIENT_TEMPERATURE=0.8
# Proactive arrival greeting
LLM_GREETING_TEMPERATURE=1.3
# Pickup / pet / fall sensor quips
LLM_SENSOR_TEMPERATURE=1.4
# Joke idle background refill (generate + critic stages)
LLM_JOKE_GENERATE_TEMPERATURE=1.0
LLM_JOKE_CRITIC_TEMPERATURE=0.2

# Timeouts (seconds)
LLM_TIMEOUT_CONNECT=15
LLM_TIMEOUT_READ=120

# Chat memory inject caps (top-k facts into the system memory section).
# Keyword + recency retrieval; raise if chat "forgets" too often, lower to save tokens.
# MEMORY_INJECT_PERSONAL=8
# MEMORY_INJECT_SHARED=4
# MEMORY_INJECT_MENTIONS=3

# Debug: log Wire-Pod requests + OpenRouter send/recv (images redacted).
# Writes to vector-ai.log (stdout) AND vector-ai-debug.log next to service.py.
# VECTORAI_DEBUG=1
# VECTORAI_DEBUG_MAX_CHARS=4000

# Optional OpenRouter leaderboard attribution
# LLM_HTTP_REFERER=https://github.com/yourname/VectorIntelligence
# LLM_APP_TITLE=VectorIntelligence

# Pushover: mirror every TTS line from vector-ai (chat, greeting, sensor,
# ambient novelty, workday/joke behaviors). Both keys required; empty = off.
# App token from https://pushover.net/apps/build → PUSHOVER_APP_KEY
# User/group key from dashboard → PUSHOVER_USER_KEY
# PUSHOVER_APP_KEY=
# PUSHOVER_USER_KEY=
# PUSHOVER_TIMEOUT_S=3

# Behavior FSMs (Work Day, Joke idle, speech gap, BEHAVIORS_ENABLED, …):
# configure in pod.conf next to supervisor (vector-pod/pod.conf), NOT here.
# See shared/config/pod.conf-default and AGENTS.md.
# Existing keys in this .env still work for local dev; when the supervisor
# injects the same key from pod.conf, pod.conf wins.
